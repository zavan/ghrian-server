<% content_for :title, "Create account" %>

<div class="mx-auto mt-10 max-w-sm">
  <div class="card">
    <h1 class="mb-5 text-xl font-semibold">Create your ghrian account</h1>

    <% if @user.errors.any? %>
      <div class="mb-4 rounded-xl border border-red-500 bg-red-500/15 px-4 py-3 text-sm text-red-200">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "field-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username", class: "field-input" %>
      </div>
      <div>
        <%= form.label :password, class: "field-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
              maxlength: 72, class: "field-input" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Repeat password", class: "field-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
              maxlength: 72, class: "field-input" %>
      </div>
      <%= form.submit "Create account", class: "btn w-full" %>
    <% end %>

    <div class="mt-4 text-sm">
      <%= link_to "Already have an account? Sign in", new_session_path, class: "text-slate-400 hover:text-slate-200" %>
    </div>
  </div>
</div>
