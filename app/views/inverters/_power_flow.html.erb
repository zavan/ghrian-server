<%# Live power-flow diagram: PV / Grid / Battery / Load around the central inverter,
    with animated connectors whose direction reflects energy flow. %>
<% snapshot ||= inverter.snapshot %>
<% nodes = {
     pv:      { name: "PV",      flow: snapshot.pv,      x: 22, y: 26, ring: "border-yellow-400", text: "text-yellow-400", stroke: "#eab308" },
     grid:    { name: "Grid",    flow: snapshot.grid,    x: 78, y: 26, ring: "border-sky-500",    text: "text-sky-400",    stroke: "#38bdf8" },
     battery: { name: "Battery", flow: snapshot.battery, x: 22, y: 74, ring: "border-green-500",  text: "text-green-400",  stroke: "#22c55e" },
     load:    { name: "Load",    flow: snapshot.load,    x: 78, y: 74, ring: "border-purple-500", text: "text-purple-400", stroke: "#a855f7" }
   } %>

<div class="relative mx-auto aspect-square w-full max-w-sm">
  <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" preserveAspectRatio="none">
    <% nodes.each_value do |node| %>
      <% flow = node[:flow] %>
      <line x1="<%= node[:x] %>" y1="<%= node[:y] %>" x2="50" y2="50" stroke="<%= node[:stroke] %>"
            class="flow-line <%= flow.active? ? "flow-line-active #{'flow-line-out' if flow.direction == :out}" : "flow-line-idle" %>" />
    <% end %>
  </svg>

  <%# Central inverter hub %>
  <div class="absolute left-1/2 top-1/2 flex size-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-amber-500 bg-slate-900 text-amber-400 shadow-lg">
    <%= power_icon :inverter, size: 28 %>
  </div>

  <% nodes.each do |key, node| %>
    <% flow = node[:flow] %>
    <div class="flow-node <%= node[:ring] %>" style="left: <%= node[:x] %>%; top: <%= node[:y] %>%;">
      <span class="<%= node[:text] %>"><%= power_icon key %></span>
      <span class="flow-node-value"><%= flow.display %></span>
    </div>
    <span class="absolute -translate-x-1/2 text-xs text-slate-400"
          style="left: <%= node[:x] %>%; top: calc(<%= node[:y] %>% + 2.85rem);"><%= node[:name] %></span>
  <% end %>
</div>
