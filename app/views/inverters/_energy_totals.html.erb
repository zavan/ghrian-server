<%# Shared energy totals grid. Local: `totals` (Inverter::EnergyTotals). %>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
  <% [
       ["Generation", totals.generation, "text-yellow-400"],
       ["Self-consumed", totals.self_consumption, "text-purple-400"],
       ["Exported", totals.feed_in, "text-sky-400"],
       ["Imported", totals.import, "text-red-400"],
       ["Charged", totals.charge, "text-green-400"],
       ["Discharged", totals.discharge, "text-green-400"]
     ].each do |name, value, color| %>
    <div>
      <p class="text-xl font-semibold <%= color %>"><%= Inverter::Snapshot.kwh(value) %></p>
      <p class="text-xs uppercase tracking-wide text-slate-400"><%= name %></p>
    </div>
  <% end %>
</div>
