<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ghrian" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ghrian">
    <meta name="apple-mobile-web-app-title" content="ghrian">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA manifest — makes the dashboard installable. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-900 text-slate-200 antialiased">
    <% if authenticated? %>
      <header class="flex items-center gap-6 border-b border-slate-700 bg-slate-800 px-6 py-3">
        <a href="<%= root_path %>" class="inline-flex items-center gap-1.5 text-lg font-bold text-slate-100">
          <%= lucide_icon "sun", class: "size-5 text-amber-400" %>ghrian
        </a>
        <nav class="flex flex-1 gap-5 text-sm">
          <% [
               ["Dashboard", root_path, "layout-dashboard"],
               ["Inverters", inverters_path, "zap"],
               ["MQTT", mqtt_config_path, "radio"],
               ["Costs", tariff_path, "circle-dollar-sign"],
               ["API Tokens", api_tokens_path, "key-round"],
               ["Users", users_path, "users"]
             ].each do |label, path, icon| %>
            <%= link_to path, class: "inline-flex items-center gap-1.5 text-slate-400 hover:text-slate-100" do %>
              <%= lucide_icon icon, class: "size-4" %><%= label %>
            <% end %>
          <% end %>
        </nav>
        <%= button_to session_path, method: :delete,
              class: "inline-flex items-center gap-1.5 text-sm text-sky-400 hover:text-sky-300" do %>
          <%= lucide_icon "log-out", class: "size-4" %>Sign out
        <% end %>
      </header>
    <% end %>

    <main class="mx-auto max-w-5xl p-6">
      <% flash.each do |type, message| %>
        <div class="mb-4 flex items-center gap-2 rounded-xl border px-4 py-3 <%= flash_classes(type) %>">
          <%= flash_icon(type) %><span><%= message %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
