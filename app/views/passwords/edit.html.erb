<% content_for :title, "Update password" %>

<div class="mx-auto mt-10 max-w-sm">
  <div class="card">
    <h1 class="mb-5 text-xl font-semibold">Update your password</h1>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, "New password", class: "field-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
              maxlength: 72, class: "field-input" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Repeat new password", class: "field-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
              maxlength: 72, class: "field-input" %>
      </div>
      <%= form.submit "Save", class: "btn w-full" %>
    <% end %>
  </div>
</div>
