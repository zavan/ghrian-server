<% content_for :title, "Reset password" %>

<div class="mx-auto mt-10 max-w-sm">
  <div class="card">
    <h1 class="mb-5 text-xl font-semibold">Forgot your password?</h1>

    <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "field-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username", value: params[:email_address], class: "field-input" %>
      </div>
      <%= form.submit "Email reset instructions", class: "btn w-full" %>
    <% end %>

    <div class="mt-4 text-sm">
      <%= link_to "Back to sign in", new_session_path, class: "text-slate-400 hover:text-slate-200" %>
    </div>
  </div>
</div>
